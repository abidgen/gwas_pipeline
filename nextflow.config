manifest {
    name        = 'gwas-pipeline'
    author      = 'Your Name'
    version     = '1.0.0'
    description = 'Reproducible modular GWAS pipeline'
    nextflowVersion = '>=23.04'
}

params {
    input_bed        = null
    phenotype        = 'data/phenotypes.csv'
    outdir           = 'results'
    ref_panel        = null
    local_1kg_prefix = null
    ancestry_ref_prefix = null
    mode             = 'full'

    mind         = 0.02
    geno         = 0.02
    maf          = 0.01
    hwe          = 1e-6
    pihat        = 0.2

    n_pcs        = 10
    pop          = 'EUR'

    gwas_pval    = 5e-8
    assoc_test   = 'logistic'

    prs_pval     = 0.5
    prs_clump_r2 = 0.1
    prs_clump_kb = 250

    max_cpus     = 32
    max_memory   = '128.GB'
    max_time     = '48.h'
}

profiles {
    standard {
        process.executor = 'local'
        includeConfig 'conf/base.config'
    }

    slurm {
        process.executor = 'slurm'
        includeConfig 'conf/base.config'
        includeConfig 'conf/hpc.config'
    }

    lsf {
        process.executor = 'lsf'
        includeConfig 'conf/base.config'
        includeConfig 'conf/hpc.config'
    }

    biowulf {
        includeConfig 'conf/hpc.config'
    }

    biowulflocal {
        includeConfig 'conf/hpc.config'
    }

    conda {
        conda.enabled  = true
        conda.useMamba = true
    }

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    test {
        params.mode      = 'full'
        params.pop       = 'EUR'
        params.gwas_pval = 1e-4
        process.cpus     = 2
        process.memory   = '4.GB'
    }
}

process {
    errorStrategy = { task.exitStatus in [130, 137, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: 'plink' {
        conda     = 'bioconda::plink=1.90b6.21'
        container = 'quay.io/biocontainers/plink:1.90b6.21--h516909a_0'
    }

    withLabel: 'r_gwas' {
        conda = 'conda-forge::r-base=4.3 bioconda::plink=1.90b6.21 conda-forge::r-data.table conda-forge::r-optparse conda-forge::r-ggplot2'
    }

    withLabel: 'prsice' {
        cpus   = 8
        memory = '32 GB'
        time   = '24 h'
    }
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/dag.svg"
}