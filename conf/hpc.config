singularity {
    enabled      = true
    autoMounts   = true
    autoPullMode = true
    cacheDir     = "/data/$USER/nxf_singularity_cache"
    libraryDir   = "/fdb/nxf/singularity-images"
    envWhitelist = 'https_proxy,http_proxy,ftp_proxy,DISPLAY,SLURM_JOB_ID,SINGULARITY_CACHEDIR,MPLCONFIGDIR'
}

env {
    SINGULARITY_CACHEDIR  = "/data/$USER/.singularity"
    OMP_NUM_THREADS       = 1
    OPENBLAS_NUM_THREADS  = 1
    PYTHONNOUSERSITE      = 1
}

// Biowulf scratch — local fast NVMe per node, auto-deleted after job
workDir = "/lscratch/$SLURM_JOB_ID/nxf_work"

// Clean up work dir after successful run (saves lscratch quota)
cleanup = true

executor {
    name              = 'slurm'
    queue             = 'norm'      // Biowulf default queue (NOT 'normal')
    queueSize         = 200
    pollInterval      = '2 min'     // required by Biowulf — do not poll too often
    queueStatInterval = '5 min'
    submitRateLimit   = '6/1min'    // Biowulf asks for this limit
}

process {
    // Request lscratch for every process (needed for workDir above)
    clusterOptions = '--nodes=1 --gres=lscratch:50'

    withLabel: 'plink' {
        queue          = 'norm'
        cpus           = 8
        memory         = '16 GB'
        time           = '8 h'
        clusterOptions = '--nodes=1 --gres=lscratch:50'
    }
    withLabel: 'r_gwas' {
        queue          = 'norm'
        cpus           = 4
        memory         = '16 GB'
        time           = '4 h'
        clusterOptions = '--nodes=1 --gres=lscratch:50'
    }
    withLabel: 'prsice' {
        queue          = 'norm'      // norm has up to 499 GB — enough for PRSice
        cpus           = 16
        memory         = '32 GB'
        time           = '24 h'
        clusterOptions = '--nodes=1 --gres=lscratch:100'
    }
}

profiles {
    // For the demo run or short debugging — runs everything on the interactive node
    biowulflocal {
        process {
            executor = 'local'
            cache    = 'lenient'
            memory   = "$SLURM_MEM_PER_NODE MB"
            cpus     = "$SLURM_CPUS_PER_TASK"
        }
    }

    // For full pipeline — submits each process as a SLURM job
    biowulf {
        // inherits everything above
    }
}